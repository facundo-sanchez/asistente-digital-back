# Copiar a .env.prod (no se versiona) y completar. Generá valores nuevos: no reutilices los de desarrollo.

# ---------- Dominios ----------
# Dominio del backend (apunta a la IP de la máquina). Caddy saca el certificado solo.
API_DOMAIN=api-asistente.duckdns.org
# URL pública del front, con el basePath si lo usás. Arma los links de los emails y los callbacks de Google.
FRONTEND_URL=https://asistente-digital.vercel.app

# ---------- Base de datos ----------
DB_USER=asistente
# openssl rand -base64 24
DB_PASSWORD=

# ---------- Login con Google y Gmail ----------
# En Google Cloud, URIs de redirección autorizadas:
#   FRONTEND_URL + /api/auth/google/callback
#   FRONTEND_URL + /api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave AES para cifrar los tokens de Gmail: openssl rand -base64 32
# No la cambies después de que alguien conecte Gmail: sus tokens dejarían de leerse.
INTEGRATIONS_KEY=

# ---------- Emails (ej. Brevo) ----------
EMAIL_DELIVERY=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_START_TLS=REQUIRED
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Asistente de Vida Digital <avisos@tu-dominio.com>

# ---------- IA ----------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
