# Copiar a .env y completar. Quarkus lo lee en modo dev; en producción, variables de entorno.

# ---------- Base de datos ----------
DB_URL=jdbc:postgresql://localhost:5432/asistente_digital
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Frontend ----------
# URL pública del front (incluido el basePath si se usa). Arma los links de los emails.
FRONTEND_URL=http://localhost:3000

# ---------- JWT ----------
# Las claves no se versionan. En desarrollo, generarlas una vez en src/main/resources:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out src/main/resources/privateKey.pem
#   openssl rsa -in src/main/resources/privateKey.pem -pubout -out src/main/resources/publicKey.pem
# En producción son obligatorias (sin ellas no arranca): archivos montados como secretos.
# JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem

# ---------- Login con Google ----------
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web).
# URI de redirección autorizada: FRONTEND_URL + /api/auth/google/callback
#   ej. http://localhost:3000/asistente-digital/api/auth/google/callback
# Sin estas dos variables el botón de Google muestra "no disponible".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------- Emails ----------
# log = se escriben en la consola (sin envío) · smtp = se envían por el servidor de abajo
EMAIL_DELIVERY=smtp

# Desarrollo: Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit)
# Bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Producción (ej. Gmail, con contraseña de aplicación):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_START_TLS=REQUIRED
# SMTP_USER=cuenta@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Asistente Digital <cuenta@gmail.com>

# ---------- IA ----------
# GEMINI_API_KEY=

# Clave AES de 32 bytes en base64 para cifrar los tokens de Gmail (openssl rand -base64 32)
INTEGRATIONS_KEY=
