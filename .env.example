# Copiar a .env y completar. Quarkus lo lee en modo dev; en producción, variables de entorno.

# ---------- Base de datos ----------
DB_URL=jdbc:postgresql://localhost:5432/asistente_digital
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Frontend ----------
# URL pública del front (incluido el basePath si se usa). Arma los links de los emails.
FRONTEND_URL=http://localhost:3000

# ---------- JWT ----------
# En producción, archivos montados como secretos (no los del repo).
# JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem

# ---------- Emails ----------
# log = se escriben en la consola (sin envío) · smtp = se envían por el servidor de abajo
EMAIL_DELIVERY=smtp

# Desarrollo: Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit)
# Bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Producción (ej. Gmail, con contraseña de aplicación):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_START_TLS=REQUIRED
# SMTP_USER=cuenta@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Asistente Digital <cuenta@gmail.com>

# ---------- IA ----------
# GEMINI_API_KEY=
